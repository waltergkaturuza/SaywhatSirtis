{
  "framework": "nextjs",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "SKIP_ENV_VALIDATION": "true"
    }
  },
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    },
    "app/api/admin/database/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/database/tables/[table]/export/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/database-backup/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/database-backup",
      "schedule": "0 2 * * *"
    }
  ]
}
